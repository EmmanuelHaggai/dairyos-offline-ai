{
  "name": "dairyos-local",
  "version": "0.6.4",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "ios": "expo run:ios --device --configuration Release",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web",
    "preview": "tsx scripts/preview-server.ts",
    "preview:docker": "DAIRYOS_DESKTOP_DOCKER=1 tsx scripts/preview-server.ts",
    "prepare:desktop": "node scripts/prepare-linux-test.mjs",
    "prepare:iphone": "node scripts/prepare-iphone.mjs",
    "build:iphone": "bash scripts/build-iphone.sh",
    "doctor:local": "node scripts/check-environment.mjs",
    "android": "expo run:android"
  },
  "dependencies": {
    "@qvac/fabric-android-arm64": "0.22.0",
    "@qvac/fabric-ios": "0.22.0",
    "@qvac/inference": "0.22.0",
    "@qvac/sdk": "0.22.0",
    "bare-rpc": "^1.3.2",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
